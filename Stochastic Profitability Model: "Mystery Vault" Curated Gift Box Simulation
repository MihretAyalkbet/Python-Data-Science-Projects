        "    item_3 = sampled_items.iloc[2][\"Item_Name\"]\n",
        "\n",
        "    total_retail = sampled_items[\"Retail_Price\"].sum()\n",
        "    total_wholesale = sampled_items[\"Wholesale_Cost\"].sum()\n",
        "\n",
        "    value_gap = total_retail - 45\n",
        "    store_profit = 45 - total_wholesale\n",
